# Verdure & Cie - variables d'environnement
# Copier ce fichier en .env si besoin.
# Ne jamais commiter .env dans Git.

PORT=3010
NODE_ENV=production
SITE_URL=https://verdure.maisonpicard.com
CONTACT_EMAIL=hello@maisonpicard.com

# Admin / espace client
ADMIN_TOKEN=change-me-long-secret
DATA_DIR=/opt/verdure/data

# Stripe Checkout pour l'acompte de 30%
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=eur
